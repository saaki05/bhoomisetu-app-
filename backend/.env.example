# ==============================
# BhoomiSetu Backend Environment
# ==============================

# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:8080

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# App JWT (used for our own access/refresh token layer on top of Supabase)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Redis (caching, rate limiting store, socket adapter)
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# SMS OTP provider (e.g. MSG91 / Twilio)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=BHMSTU

# Email service (e.g. SMTP / SendGrid)
EMAIL_FROM=no-reply@bhoomisetu.app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Cloudinary (optional media storage alongside Supabase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weather API (e.g. OpenWeatherMap)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# Google Maps / Geocoding
GOOGLE_MAPS_API_KEY=

# Market Price API (e.g. data.gov.in Agmarknet)
MARKET_PRICE_API_KEY=
MARKET_PRICE_API_BASE_URL=

# Showcase catalog. Set false when replacing the curated launch catalog
# with production-managed listings.
BOOTSTRAP_DEMO_CATALOG=true

# Logging
LOG_LEVEL=info
