# ==============================
# BhoomiSetu Flutter App Environment
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# ==============================

# Backend API — a deployed HTTPS URL works from any network.
# For local backend development instead:
#   emulator:       http://10.0.2.2:4000
#   physical phone: http://<your-LAN-IP>:4000
#     (must also be listed in android/.../network_security_config.xml,
#      since Android blocks cleartext HTTP by default)
API_BASE_URL=https://your-backend.onrender.com/api/v1
SOCKET_URL=https://your-backend.onrender.com

# Supabase (public/anon values only — never put the service role key here)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google
GOOGLE_MAPS_API_KEY=
GOOGLE_SIGN_IN_WEB_CLIENT_ID=

# Weather (used if the app calls the weather provider directly instead of via backend)
WEATHER_API_KEY=

APP_ENV=development
